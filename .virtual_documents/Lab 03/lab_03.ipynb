# Task # 23

def entropy(data):
    if len(data) == 0:
        return 0

    target = data.iloc[:, -1]
    probabilities = target.value_counts(normalize = True)

    ent = 0

    for p in probabilities:
        ent -= p * math.log2(p)

    return ent


def information_gain(data, attribute):
    total_entropy = entropy(data)

    weighted_entropy = 0

    for value in data[attribute].unique():
        subset = data[data[attribute] == value]
        weight = len(subset) / len(data)

        weighted_entropy += weight * entropy(subset)

    gain = total_entropy - weighted_entropy

    return gain


def id3(data, attributes, level=0):

    target = data.iloc[:, -1]

    if len(target.unique()) == 1:
        return target.iloc[0]

    if len(attributes) == 0:
        return target.mode()[0]

    gains = {}

    print("\n" + "  " * level + "Information Gain:")

    for attribute in attributes:
        gain = information_gain(data, attribute)
        gains[attribute] = gain

        print("  " * level + f"{attribute}: {gain:.4f}")

    best_attribute = max(gains, key=gains.get)

    print("  " * level + f"Best Attribute: {best_attribute}")

    tree = {best_attribute: {}}

    remaining_attributes = [
        attr for attr in attributes
        if attr != best_attribute
    ]

    for value in data[best_attribute].unique():

        subset = data[data[best_attribute] == value]

        print("  " * level + f"Branch: {best_attribute} = {value}")

        tree[best_attribute][value] = id3(
            subset,
            remaining_attributes,
            level + 1
        )

    return tree


df_tennis = pd.read_csv("Play_Tennis.csv")

print(df_tennis)

attributes = list(df_tennis.columns[:-1])

tree = id3(df_tennis, attributes)

print("\nFinal ID3 Decision Tree:")
