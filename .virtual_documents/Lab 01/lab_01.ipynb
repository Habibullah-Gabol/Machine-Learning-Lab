print("\nNaNs remaining:", df["score"].isna().sum())


# Task # 35: Combine Pandas and Matplotlib: read a small CSV of monthly expenses into a DataFrame, 
# group by category, and plot the totals as a pie chart.

import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv("monthly_expenses.csv")

category_totals = df.groupby("category")["amount"].sum()

category_totals.plot(
    kind = "pie",
    autopct = "%1.1f%%",
    title = "Monthly Expenses by Category"
)

plt.ylabel("") 
plt.show()



