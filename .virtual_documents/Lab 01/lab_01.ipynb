# Task # 02: 2.	Write a function is_prime(n) that returns True if n is a prime number, otherwise False.

def is_prime(x):
    count = 0
    for i in range(x):
        if(i <= 1):
            continue
        if(i > 1 & x % i == 0):
            count += 1
            
    if(count == 1):
        return True
    else:
        return False

is_prime(9)


