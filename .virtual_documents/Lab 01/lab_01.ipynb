# Task # 30: Create a 2x2 grid of subplots showing four different chart types 
# (line, bar, scatter, histogram) from the same dataset.

import numpy as np
import matplotlib.pyplot as plt

data = np.array([10, 15, 12, 18, 20, 17, 25, 22, 30, 28])
x = np.arange(1, len(data) + 1)

plt.figure(figsize=(10, 8))

plt.subplot(2, 2, 1)
plt.plot(x, data)
plt.title("Line Chart")
plt.xlabel("Index")
plt.ylabel("Value")

plt.subplot(2, 2, 2)
plt.bar(x, data)
plt.title("Bar Chart")
plt.xlabel("Index")
plt.ylabel("Value")

plt.subplot(2, 2, 3)
plt.scatter(x, data)
plt.title("Scatter Plot")
plt.xlabel("Index")
plt.ylabel("Value")

plt.subplot(2, 2, 4)
plt.hist(data, bins=5)
plt.title("Histogram")
plt.xlabel("Value")
plt.ylabel("Frequency")

plt.tight_layout()

plt.show()


